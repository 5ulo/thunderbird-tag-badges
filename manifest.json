{
  "manifest_version": 2,
  "name": "Tag Badges for Thunderbird",
  "version": "0.3.0",
  "author": "EnjoyDev",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "tag-badges-thread-pane@local.invalid",
      "strict_min_version": "128.0",
      "strict_max_version": "161.*",
      "update_url": "https://github.com/5ulo/thunderbird-tag-badges/releases/latest/download/updates.json"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "tagBadges": {
      "schema": "experiments/tagBadges/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "tagBadges"
          ]
        ],
        "script": "experiments/tagBadges/api.js"
      }
    }
  },
  "default_locale": "en",
  "homepage_url": "https://github.com/5ulo/thunderbird-tag-badges"
}
